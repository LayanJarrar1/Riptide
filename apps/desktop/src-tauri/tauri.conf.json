{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riptide",
  "mainBinaryName": "riptide-desktop",
  "identifier": "app.riptide.desktop",
  "build": {
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/desktop/browser",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Riptide",
        "width": 1280,
        "height": 780,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:4200 http://localhost:4200",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Riptide",
    "copyright": "Copyright (c) Riptide contributors. Licensed under GPL-3.0-or-later.",
    "shortDescription": "Free, open-source download manager with Arabic and English interface.",
    "category": "Utility",
    "licenseFile": "../../../LICENSE",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwOUYzNzQyMDgxMjBDOUIKUldTYkRCSUlRamVmQUttNXhscDBiZGFES3BRa0hUTzA5SmtMMTFtMUVUZjJ0RTB0QWs3T2MrL0MK",
      "endpoints": [
        "https://github.com/LayanJarrar1/Riptide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
