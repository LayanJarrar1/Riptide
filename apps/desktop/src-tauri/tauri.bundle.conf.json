{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/stage-host.mjs && node scripts/stage-extension.mjs && node scripts/fetch-media-tools.mjs"
  },
  "bundle": {
    "externalBin": ["binaries/riptide-host", "binaries/yt-dlp", "binaries/ffmpeg"],
    "resources": {
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "binaries/ffmpeg-LICENSE.txt": "licenses/ffmpeg-LICENSE.txt",
      "binaries/yt-dlp-LICENSE.txt": "licenses/yt-dlp-LICENSE.txt",
      "../../extension/dist/chrome": "extension/chrome",
      "../../extension/dist/edge": "extension/edge",
      "../../../scripts/install-extension.ps1": "install-extension.ps1"
    }
  }
}
